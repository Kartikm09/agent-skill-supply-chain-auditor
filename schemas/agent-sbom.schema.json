{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-skill-auditor/agent-sbom.schema.json",
  "title": "Agent-SBOM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bomFormat",
    "specVersion",
    "serialNumber",
    "metadata",
    "governance",
    "components",
    "dependencies",
    "capabilities",
    "mcpServers"
  ],
